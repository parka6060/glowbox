// OKLab is used only when smoothing the small artistic colour signal.
// Source energy, coverage, spatial integration and final lighting stay linear.
// Matrices: https://bottosson.github.io/posts/oklab/ (public domain).
float3 LinearToOklab(float3 c) {
    float3 cone=float3(dot(c,float3(.4122214708,.5363325363,.0514459929)),
                       dot(c,float3(.2119034982,.6806995451,.1073969566)),
                       dot(c,float3(.0883024619,.2817188376,.6299787005)));
    cone=pow(max(cone,0),1.0/3.0);
    return float3(dot(cone,float3(.2104542553,.7936177850,-.0040720468)),
                  dot(cone,float3(1.9779984951,-2.4285922050,.4505937099)),
                  dot(cone,float3(.0259040371,.7827717662,-.8086757660)));
}
float3 OklabToLinear(float3 c) {
    float3 cone=float3(c.x+.3963377774*c.y+.2158037573*c.z,
                       c.x-.1055613458*c.y-.0638541728*c.z,
                       c.x-.0894841775*c.y-1.2914855480*c.z);
    cone=cone*cone*cone;
    return float3(dot(cone,float3(4.0767416621,-3.3077115913,.2309699292)),
                  dot(cone,float3(-1.2684380046,2.6097574011,-.3413193965)),
                  dot(cone,float3(-.0041960863,-.7034186147,1.7076147010)));
}
float4 SmoothReactiveColor(float4 previous, float4 current, float response) {
    if (response>=1) return current;
    if (response<=0) return previous;
    float energy=lerp(previous.a,current.a,response);
    if (energy<=.000001) return float4(0,0,0,0);
    float3 before=previous.rgb/max(previous.a,.000001);
    float3 after=current.rgb/max(current.a,.000001);
    // An absent light has no hue. Fade its energy without steering toward black.
    if (previous.a<=.000001) return float4(after*energy,energy);
    if (current.a<=.000001) return float4(before*energy,energy);
    float weight=current.a*response/energy;
    float3 lab=lerp(LinearToOklab(before),LinearToOklab(after),weight);
    float3 rgb=OklabToLinear(lab);
    // The light field stores unit-peak chromaticity, not display lightness.
    // A rare negative channel is fitted by reducing chroma at fixed L and hue.
    if (min(rgb.r,min(rgb.g,rgb.b))<-.000001) {
        float low=0, high=1;
        for (int i=0;i<8;++i) {
            float scale=(low+high)*.5;
            float3 candidate=OklabToLinear(float3(lab.x,lab.yz*scale));
            if (min(candidate.r,min(candidate.g,candidate.b))>=0) low=scale;
            else high=scale;
        }
        rgb=OklabToLinear(float3(lab.x,lab.yz*low));
    }
    rgb=max(rgb,0);
    rgb/=max(max(rgb.r,max(rgb.g,rgb.b)),.000001);
    return float4(rgb*energy,energy);
}
